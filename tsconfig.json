{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["apps/*/src/**/*.ts", "apps/*/src/**/*.tsx", "packages/core/src/**/*.ts", "hub/**/*.ts"],
  "exclude": ["**/*.test.ts", "legacy", "dist"]
}
